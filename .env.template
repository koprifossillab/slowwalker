# slowwalker 환경변수. `.env` 로 복사해 채운다. `.env` 는 커밋하지 않는다.

# Django
SLOWWALKER_SECRET_KEY=개발용-아무-값-운영에서는-반드시-바꾼다
SLOWWALKER_DEBUG=1
SLOWWALKER_ALLOWED_HOSTS=127.0.0.1,localhost
SLOWWALKER_CSRF_TRUSTED_ORIGINS=
# 서브패스에 걸 때만 채운다 (예: slowwalker/). 비우면 뿌리에 선다
SLOWWALKER_URL_PREFIX=

# 산출을 넣고 고치는 데 로그인을 묻는가. 0 이면 누구나 고친다(연구소 안 시험용)
SLOWWALKER_EDIT_REQUIRES_LOGIN=0

# DB. 비우면 저장소 뿌리의 slowwalker.db
SLOWWALKER_DB_PATH=
SLOWWALKER_LOG_LEVEL=INFO
